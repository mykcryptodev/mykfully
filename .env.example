# Public URL of the app (no trailing slash). Must match the X callback: $APP_URL/api/auth/callback
APP_URL=http://localhost:3000

# X (Twitter) OAuth 2.0 app credentials — https://console.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=

# Random secrets
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32   (32-byte key for encrypting X tokens at rest)
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32      (Vercel Cron sends it as "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Postgres (e.g. Neon). Leave empty locally to use an embedded PGlite database in ./.data
DATABASE_URL=

# Set to 1 to use a fake X API (no credentials needed; nothing is really posted)
MOCK_X=0

# --- Credits (1 credit ≈ $0.001 of X API spend) ---
# Comma-separated X user ids (numbers, not handles) with admin rights: unlimited credits + /admin page.
# Your id is shown in the app's account menu after you sign in.
ADMIN_X_USER_IDS=
# Credits granted once to each new X account on first sign-in (default 1000 ≈ $1). Set 0 to require admin grants.
SIGNUP_CREDITS=1000
# Max total non-admin spend per rolling 24h across the instance (default 20000 ≈ $20/day; 0 = no cap).
GLOBAL_DAILY_CREDIT_CAP=20000
# Optional: comma-separated X user ids allowed to sign in (empty = anyone). Admins are always allowed.
ALLOWED_X_USER_IDS=
# Optional cost overrides if X changes pricing
# CREDIT_COST_POST=15
# CREDIT_COST_POST_WITH_URL=200
# CREDIT_COST_USER_READ=10
# CREDIT_COST_MEDIA_UPLOAD=0
# CREDIT_COST_MEDIA_METADATA=5

# --- Optional: sell credits for USDC on Base via x402 (off unless PAY_TO_ADDRESS and X402_NETWORK are both valid) ---
# Wallet address that receives the USDC (0x…, checksummed or all lowercase). Use an address you control.
PAY_TO_ADDRESS=
# "base-sepolia" (testnet, free x402.org facilitator) or "base" (mainnet, needs the CDP keys below).
X402_NETWORK=
# Coinbase Developer Platform API key (https://portal.cdp.coinbase.com) — required for X402_NETWORK=base only.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional JSON-RPC URL for `pnpm purchases:reconcile` (defaults to the chain's public RPC).
# X402_RPC_URL=
